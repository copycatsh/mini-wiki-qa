# ==============================================
# LLM Backend Configuration
# ==============================================
# Options: lm-studio | ollama | openai
LLM_BACKEND=lm-studio

# LM Studio (for development, GUI-based)
LM_STUDIO_MODEL=phi-3-mini-4k-instruct
# LM_STUDIO_URL=http://host.docker.internal:1234/v1

# Ollama (for production, CLI-based)
OLLAMA_MODEL=phi3
# OLLAMA_URL=http://ollama:11434/v1

# OpenAI (optional, cloud-based)
OPENAI_API_KEY=

# ==============================================
# Security
# ==============================================
API_SHARED_SECRET=change-me-in-production

# ==============================================
# MinIO / S3 Storage
# Note: changing these after first run requires resetting the minio volume (docker volume rm mini-wiki-qa_minio_data)
# ==============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ==============================================
# Vector DB
# ==============================================
# QDRANT_URL=http://qdrant:6333
# QDRANT_COLLECTION=mini-wiki

# ==============================================
# Embeddings
# ==============================================
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIM=384

# ==============================================
# RAG Settings
# ==============================================
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
# TOP_K=5
# MAX_HISTORY_PAIRS=5

# ==============================================
# MLflow
# ==============================================
# MLFLOW_TRACKING_URI=http://mlflow:5000
# MLFLOW_EXPERIMENT_NAME=mini-wiki-rag

# ==============================================
# Application Settings
# ==============================================
LOG_LEVEL=INFO

# ==============================================
# n8n Settings
# ==============================================
N8N_HOST=localhost
N8N_USER_MANAGEMENT_DISABLED=true

# ==============================================
# Docker Resources (for reference)
# ==============================================
# Docker Desktop → Settings → Resources:
# - CPUs: 6
# - Memory: 12GB